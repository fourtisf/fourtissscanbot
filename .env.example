# =============================================================
# CRYPTO PRICE & SCANNER BOT - ENVIRONMENT VARIABLES (TEMPLATE)
# =============================================================
# Salin file ini menjadi ".env" lalu isi nilai aslinya.
#   cp .env.example .env
# JANGAN pernah commit file .env yang berisi token/API key asli!

# REQUIRED: Telegram Bot Token dari @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# ---- API Keys (opsional tapi disarankan) ----
COVALENT_API_KEY=
ETHERSCAN_API_KEY=
ETHERSCAN_KEY=
COINMARKETCAP_API_KEY=
BSCSCAN_API_KEY=
BASESCAN_API_KEY=
SOL_RPC=
CODEX_API_KEY=
HELIUS_API_KEY=
TRON_API=

# ---- Bot Configuration ----
MAX_TOKENS_PER_CHAIN=3
DEFAULT_TIMEFRAME=1h
CHART_WIDTH=1000
CHART_HEIGHT=600
REQUESTS_PER_MINUTE=60
CACHE_DURATION=300

# ---- Resource Guard (anti-crash) ----
# Jumlah maksimum Chromium yang boleh render chart bersamaan.
# Biarkan 1 pada VPS kecil supaya tidak kehabisan RAM (OOM).
MAX_CONCURRENT_CHARTS=1
# Lama menunggu live chart render sebelum di-screenshot (milidetik).
CHART_RENDER_WAIT_MS=15000

# ---- Development ----
DEBUG_MODE=false
LOG_LEVEL=INFO

# ---- Deployment (opsional, hanya untuk webhook) ----
WEBHOOK_URL=
PORT=8443
