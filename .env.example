# Salin file ini ke .env di server dan isi nilainya.
# JANGAN commit .env ke git — token yang bocor akan dipakai orang lain
# (bot kena 409 Conflict / token di-revoke Telegram dan bot mati).

TELEGRAM_BOT_TOKEN=

# API keys (opsional — fitur terkait dilewati kalau kosong)
COVALENT_API_KEY=
ETHERSCAN_API_KEY=
COINMARKETCAP_API_KEY=
ETHERSCAN_KEY=
BSCSCAN_API_KEY=
BASESCAN_API_KEY=
SOL_RPC=
CODEX_API_KEY=
HELIUS_API_KEY=
TRON_API=

# Pengaturan bot (opsional, ada default)
MAX_TOKENS_PER_CHAIN=3
DEFAULT_TIMEFRAME=1h
CHART_WIDTH=1000
CHART_HEIGHT=600
REQUESTS_PER_MINUTE=60
CACHE_DURATION=300
DEBUG_MODE=false
LOG_LEVEL=INFO
WEBHOOK_URL=
PORT=8443

# Laporan status "Fourtis LIVE" ke channel
REPORT_CHANNEL_ID=@FourtisScan
REPORT_ADMIN_ID=5231963014
REPORT_INTERVAL_SEC=43200
REPORT_FIRST_SEC=20

# Watchdog anti-freeze: kalau event loop beku selama sekian detik, proses
# dipaksa restart supaya supervisor (PM2/systemd) menghidupkan lagi. Default 120.
WATCHDOG_TIMEOUT=120
