# Salin file ini menjadi .env lalu isi. JANGAN commit .env ke GitHub —
# token yang bocor akan dipakai orang lain (bot kena 409 Conflict / token
# di-revoke Telegram dan bot mati).

# WAJIB — dari @BotFather
TELEGRAM_BOT_TOKEN=

# Disarankan — satu key Etherscan (API V2) untuk ETH, BSC dan Base
# https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Disarankan — info creator & holder token Solana (paket gratis cukup)
# https://dashboard.helius.dev
HELIUS_API_KEY=

# RPC Solana untuk fallback on-chain token pump.fun (kalau API pump.fun
# memblokir IP server). Kosong → pakai Helius (HELIUS_API_KEY) kalau ada,
# kalau tidak → RPC publik api.mainnet-beta.solana.com (rate-limit ketat).
SOL_RPC=

# Opsional — kosongkan saja kalau tidak punya
# top 10 holder token EVM
COVALENT_API_KEY=
# kosong = otomatis pakai CoinGecko (gratis)
COINMARKETCAP_API_KEY=

# Opsional — URL ping monitor (mis. https://hc-ping.com/xxxx dari healthchecks.io).
# Kalau bot mati/macet, layanan itu kirim alert ke email/Telegram Anda.
HEALTHCHECK_URL=

# Pengaturan bot (opsional, ada default)
MAX_TOKENS_PER_CHAIN=3
DEFAULT_TIMEFRAME=1h
CHART_WIDTH=1000
CHART_HEIGHT=600
# Maksimal Chromium render chart bersamaan (tiap instance makan ratusan MB RAM)
MAX_PARALLEL_CHARTS=2
REQUESTS_PER_MINUTE=60
CACHE_DURATION=300
WEBHOOK_URL=
PORT=8443

# Laporan status "Fourtis LIVE" ke channel
REPORT_CHANNEL_ID=@FourtisScan
REPORT_ADMIN_ID=5231963014
REPORT_INTERVAL_SEC=43200
REPORT_FIRST_SEC=20

# Watchdog anti-freeze: kalau event loop beku selama sekian detik, proses
# dipaksa restart supaya supervisor (PM2/systemd) menghidupkan lagi. Default 120.
WATCHDOG_TIMEOUT=120
