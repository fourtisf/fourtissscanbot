# Salin file ini menjadi .env lalu isi. JANGAN commit .env ke GitHub.

# WAJIB — dari @BotFather
TELEGRAM_BOT_TOKEN=

# Disarankan — satu key Etherscan (API V2) untuk ETH, BSC dan Base
# https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Disarankan — info creator & holder token Solana (paket gratis cukup)
# https://dashboard.helius.dev
HELIUS_API_KEY=

# Opsional — kosongkan saja kalau tidak punya
# top 10 holder token EVM
COVALENT_API_KEY=
# kosong = otomatis pakai CoinGecko (gratis)
COINMARKETCAP_API_KEY=

# Opsional — URL ping monitor (mis. https://hc-ping.com/xxxx dari healthchecks.io).
# Kalau bot mati/macet, layanan itu kirim alert ke email/Telegram Anda.
HEALTHCHECK_URL=
