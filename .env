# =============================================================================
# BOT CONFIGURATION (All Optional - Defaults Provided)
# =============================================================================

# Maximum tokens to show per blockchain (default: 3)
MAX_TOKENS_PER_CHAIN=3

# Default chart timeframe (default: 1h)
# Options: 1s, 1m, 3m, 5m, 15m, 30m, 1h, 2h, 4h, 8h, 12h, 1d, 3d, 1w
DEFAULT_TIMEFRAME=1h

# Chart dimensions for high quality
CHART_WIDTH=1000
CHART_HEIGHT=600

# Rate limiting (requests per minute)
REQUESTS_PER_MINUTE=60

# Cache duration in seconds (default: 300 = 5 minutes)
CACHE_DURATION=300

# =============================================================================
# DEVELOPMENT SETTINGS (Optional)
# =============================================================================

# Enable debug logging (true/false)
DEBUG_MODE=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# DEPLOYMENT SETTINGS (Optional - Only for Production)
# =============================================================================

# Webhook URL for production deployment
# Only needed if deploying with webhooks instead of polling
